{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astravalue.local/schemas/source-registry-v1.json",
  "title": "AstraValue versioned source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "effective_at",
    "question_set_version",
    "definitions",
    "legacy_definitions",
    "aliases"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"type": "string", "minLength": 1},
    "registry_version": {"type": "string", "minLength": 1},
    "effective_at": {"type": "string", "format": "date-time"},
    "question_set_version": {"type": "string", "minLength": 1},
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_definition"}
    },
    "legacy_definitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_definition"}
    },
    "aliases": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_alias"}
    }
  },
  "$defs": {
    "endpoint_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "port", "path_prefix"],
      "properties": {
        "scheme": {"const": "https"},
        "host": {"type": "string", "minLength": 1, "not": {"pattern": "\\*"}},
        "port": {"const": 443},
        "path_prefix": {"type": "string", "pattern": "^/"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markets", "tickers", "excluded_tickers"],
      "properties": {
        "markets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ALL", "SSE", "SZSE"]}
        },
        "tickers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{6}$"}},
        "excluded_tickers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{6}$"}}
      }
    },
    "incremental_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlap_days",
        "canonical_id_required",
        "use_etag",
        "use_last_modified",
        "hash_is_final",
        "checkpoint_compatible_from_versions",
        "historical_reconcile_days",
        "silent_replacement_limit"
      ],
      "properties": {
        "overlap_days": {"type": "integer", "minimum": 0},
        "canonical_id_required": {"type": "boolean"},
        "use_etag": {"type": "boolean"},
        "use_last_modified": {"type": "boolean"},
        "hash_is_final": {"const": true},
        "checkpoint_compatible_from_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "content_validator_compatible_from_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}},
        "historical_reconcile_days": {"type": ["integer", "null"], "minimum": 1},
        "silent_replacement_limit": {"type": ["string", "null"]}
      }
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_body", "content_body", "independent_replay_required"],
      "properties": {
        "discovery_body": {"enum": ["retain", "minimal_proof", "forbidden"]},
        "content_body": {"enum": ["allowed", "denied", "pending"]},
        "independent_replay_required": {"type": "boolean"}
      }
    },
    "response_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_response_bytes", "max_compressed_bytes", "max_decompressed_bytes", "max_redirects"],
      "properties": {
        "max_response_bytes": {"type": "integer", "minimum": 1},
        "max_compressed_bytes": {"type": "integer", "minimum": 1},
        "max_decompressed_bytes": {"type": "integer", "minimum": 1},
        "max_redirects": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_concurrency", "min_interval_seconds", "workspace_shared"],
      "properties": {
        "max_concurrency": {"const": 1},
        "min_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
        "workspace_shared": {"const": true}
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "retryable_methods",
        "initial_backoff_seconds",
        "max_backoff_seconds",
        "retry_after_cap_seconds",
        "request_timeout_seconds",
        "attempt_deadline_seconds"
      ],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "retryable_methods": {"type": "array", "uniqueItems": true, "items": {"enum": ["GET", "HEAD", "POST"]}},
        "initial_backoff_seconds": {"type": "number", "minimum": 0},
        "max_backoff_seconds": {"type": "number", "minimum": 0},
        "retry_after_cap_seconds": {"type": "number", "exclusiveMinimum": 0},
        "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "attempt_deadline_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "license_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automated_access",
        "archive_original",
        "save_derived_text",
        "llm_processing",
        "access_cost",
        "evidence_basis",
        "checked_at",
        "restrictions"
      ],
      "properties": {
        "automated_access": {"enum": ["allowed", "denied", "pending"]},
        "archive_original": {"enum": ["allowed", "denied", "pending"]},
        "save_derived_text": {"enum": ["allowed", "denied", "pending"]},
        "llm_processing": {"enum": ["allowed", "denied", "pending"]},
        "access_cost": {"enum": ["free", "user_configured", "paid"]},
        "evidence_basis": {"type": "string", "minLength": 1},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "restrictions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "live_access_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checklist_version",
        "completed_checks",
        "reviewed_at",
        "reviewed_by",
        "evidence_reference"
      ],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected", "not_required"]},
        "checklist_version": {"type": "string", "minLength": 1},
        "completed_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "exact_request_endpoints",
              "exact_redirect_boundaries",
              "access_method",
              "response_schema",
              "time_semantics",
              "discovery_and_content_retention",
              "response_limits",
              "rate_and_retry",
              "license_terms",
              "llm_terms"
            ]
          }
        },
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "reviewed_by": {"type": ["string", "null"], "minLength": 1},
        "evidence_reference": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["approved", "rejected"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "completed_checks": {"minItems": 10},
              "reviewed_at": {"type": "string", "format": "date-time"},
              "reviewed_by": {"type": "string", "minLength": 1},
              "evidence_reference": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "page_parameter",
        "page_size_parameter",
        "page_size",
        "cursor_parameter",
        "termination",
        "total_path",
        "items_path"
      ],
      "properties": {
        "strategy": {"enum": ["none", "page", "cursor"]},
        "page_parameter": {"type": ["string", "null"]},
        "page_size_parameter": {"type": ["string", "null"]},
        "page_size": {"type": ["integer", "null"], "minimum": 1},
        "cursor_parameter": {"type": ["string", "null"]},
        "termination": {"enum": ["single_response", "declared_total", "declared_page_count", "empty_page_with_total", "next_cursor_absent"]},
        "total_path": {"type": ["string", "null"]},
        "items_path": {"type": "string", "minLength": 1}
      }
    },
    "discovery_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "response_mime_types", "root_type", "required_paths", "resource_fields"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "response_mime_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "root_type": {"enum": ["object", "array"]},
        "required_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "resource_fields": {
          "type": "object",
          "required": ["canonical_id", "url", "title"],
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "parameter_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_query_id",
        "match_metadata_key",
        "match_value_template",
        "value_metadata_key",
        "value_template"
      ],
      "properties": {
        "source_query_id": {"type": "string", "minLength": 1},
        "match_metadata_key": {"type": "string", "minLength": 1},
        "match_value_template": {"type": "string", "minLength": 1},
        "value_metadata_key": {"type": "string", "minLength": 1},
        "value_template": {"type": "string", "minLength": 1}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "query_family",
        "query_stage",
        "execution_key",
        "adapter_operation",
        "question_ids",
        "request_method",
        "endpoint",
        "parameter_template",
        "allowed_parameter_names",
        "partition_key",
        "earliest_available_at",
        "max_window_days",
        "pagination",
        "discovery_schema",
        "discovery_body_policy",
        "fetch_policy",
        "canonical_id_rule",
        "smoke_enabled"
      ],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "query_family": {"type": "string", "minLength": 1},
        "query_stage": {"const": "discovery"},
        "execution_key": {"type": "string", "minLength": 1},
        "adapter_operation": {"type": "string", "minLength": 1},
        "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "request_method": {"enum": ["GET", "POST"]},
        "request_encoding": {"enum": ["query", "form", "json"]},
        "fixed_headers": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9!#$%&'*+.^_`|~-]+$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "endpoint": {"type": ["string", "null"], "format": "uri"},
        "parameter_template": {"type": "object"},
        "parameter_bindings": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/parameter_binding"}
        },
        "allowed_parameter_names": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "partition_key": {"type": "string", "minLength": 1},
        "earliest_available_at": {"type": ["string", "null"], "format": "date-time"},
        "max_window_days": {"type": ["integer", "null"], "minimum": 1},
        "pagination": {"$ref": "#/$defs/pagination"},
        "discovery_schema": {"$ref": "#/$defs/discovery_schema"},
        "discovery_body_policy": {"enum": ["retain", "minimal_proof", "forbidden"]},
        "fetch_policy": {"enum": ["metadata_only", "required_attachment"]},
        "canonical_id_rule": {"type": "string", "minLength": 1},
        "smoke_enabled": {"type": "boolean"}
      }
    },
    "source_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_definition_id",
        "version",
        "upstream_identity",
        "display_name",
        "authority_level",
        "adapter_key",
        "policy_status",
        "enabled",
        "access_method",
        "scopes",
        "scope_version",
        "topics",
        "applicability",
        "refresh_frequency",
        "initial_request_allowlist",
        "redirect_allowlist",
        "source_timezone",
        "published_at_precision",
        "incremental_policy",
        "retention_policy",
        "response_limits",
        "rate_limit",
        "retry_policy",
        "license_policy",
        "live_access_review",
        "effective_at",
        "expires_at",
        "queries",
        "aliases",
        "legacy"
      ],
      "properties": {
        "source_definition_id": {"type": "string", "minLength": 1},
        "content_selection_policy": {"enum": [null, "business_model_no_standalone_audit_pdf_v1", "business_model_no_audit_english_annual_v1"]},
        "version": {"type": "string", "minLength": 1},
        "upstream_identity": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "authority_level": {"type": "integer", "minimum": 1, "maximum": 5},
        "adapter_key": {"type": "string", "minLength": 1},
        "policy_status": {"enum": ["enabled", "pending_policy", "disabled", "legacy"]},
        "enabled": {"type": "boolean"},
        "access_method": {"enum": ["https_api", "https_document", "disabled", "legacy_adapter"]},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "scope_version": {"type": ["string", "null"]},
        "topics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "applicability": {"$ref": "#/$defs/applicability"},
        "refresh_frequency": {"type": "string", "minLength": 1},
        "initial_request_allowlist": {"type": "array", "items": {"$ref": "#/$defs/endpoint_rule"}},
        "redirect_allowlist": {"type": "array", "items": {"$ref": "#/$defs/endpoint_rule"}},
        "source_timezone": {"type": "string", "minLength": 1},
        "published_at_precision": {"enum": ["instant", "date", "unknown"]},
        "incremental_policy": {"$ref": "#/$defs/incremental_policy"},
        "retention_policy": {"$ref": "#/$defs/retention_policy"},
        "response_limits": {"$ref": "#/$defs/response_limits"},
        "rate_limit": {"$ref": "#/$defs/rate_limit"},
        "retry_policy": {"$ref": "#/$defs/retry_policy"},
        "license_policy": {"$ref": "#/$defs/license_policy"},
        "live_access_review": {"$ref": "#/$defs/live_access_review"},
        "effective_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "queries": {"type": "array", "items": {"$ref": "#/$defs/query"}},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "legacy": {"type": "boolean"},
        "collection_role": {"enum": ["primary", "on_demand", null]},
        "supplements_source_id": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "live_access_review": {
                "properties": {
                  "status": {"const": "rejected"}
                },
                "required": ["status"]
              }
            },
            "required": ["live_access_review"]
          },
          "then": {
            "properties": {
              "policy_status": {"enum": ["pending_policy", "disabled"]},
              "enabled": {"const": false},
              "access_method": {"const": "disabled"},
              "initial_request_allowlist": {"maxItems": 0},
              "redirect_allowlist": {"maxItems": 0},
              "queries": {
                "items": {
                  "properties": {
                    "endpoint": {"type": "null"}
                  },
                  "required": ["endpoint"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "policy_status": {"const": "pending_policy"}
            },
            "required": ["policy_status"]
          },
          "then": {
            "properties": {
              "enabled": {"const": false},
              "access_method": {"const": "disabled"},
              "initial_request_allowlist": {"maxItems": 0},
              "redirect_allowlist": {"maxItems": 0},
              "queries": {
                "items": {
                  "properties": {
                    "endpoint": {"type": "null"}
                  },
                  "required": ["endpoint"]
                }
              }
            }
          }
        }
      ]
    },
    "source_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "target_source_definition_ids", "scopes", "deprecated"],
      "properties": {
        "alias": {"type": "string", "minLength": 1},
        "target_source_definition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "deprecated": {"type": "boolean"}
      }
    }
  }
}
